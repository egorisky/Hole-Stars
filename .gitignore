# ---------------------------------------------
# Unity 6 project .gitignore  (HoleStars)
# ---------------------------------------------

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/.utmp/

# Asset Store / plugin junk
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE / editor files
.vs/
.idea/
.gradle/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Crash / profiling
sysinfo.txt
crashlytics-build.properties
*.stackdump

# Local secrets - never commit API keys (see ChatManager.cs)
/secrets/

# Builds & packages
*.apk
*.aab
*.unitypackage
*.app
/[Ee]xport[Pp]ackages/

# Secrets — never commit these
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
